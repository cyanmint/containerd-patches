diff --git a/cmd/ctr/app/main.go b/cmd/ctr/app/main.go
index d03ba9b..8775da6 100644
--- a/cmd/ctr/app/main.go
+++ b/cmd/ctr/app/main.go
@@ -143,6 +143,20 @@ containerd CLI
 		deprecations.Command,
 	}, extraCmds...)
 	app.Before = func(cliContext *cli.Context) error {
+		if defaults.PathPrefix != "" {
+			// On devices without /etc/resolv.conf (e.g. Android/Termux), configure
+			// the Go DNS resolver to use nameservers from <prefix>/etc/resolv.conf.
+			defaults.ConfigureResolver()
+			// Configure TLS to trust CA certificates from the prefixed paths
+			// (needed on Android/Termux where system certs live under the prefix).
+			defaults.ConfigureTLS()
+			// Only override address if the user did not set it explicitly.
+			if !cliContext.IsSet("address") {
+				if err := cliContext.Set("address", defaults.Prefix(defaults.DefaultAddress)); err != nil {
+					return err
+				}
+			}
+		}
 		if cliContext.Bool("debug") {
 			return log.SetLevel("debug")
 		}
