+package defaults
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"net/http"
+	"os"
+	"path/filepath"
+)
+
+// ConfigureTLS overrides http.DefaultTransport to trust CA certificates
+// loaded from Prefix("/etc/ssl/certs") and related paths under PathPrefix.
+// This is needed on devices (e.g. Android/Termux) where system CA
+// certificates are stored under the prefix rather than at standard
+// system paths.  It is a no-op when PathPrefix is empty or when no
+// certificates can be loaded from the prefix paths.
+func ConfigureTLS() {
+	if PathPrefix == "" {
+		return
+	}
+	pool := BuildCertPool()
+	if pool == nil {
+		return
+	}
+	if t, ok := http.DefaultTransport.(*http.Transport); ok {
+		clone := t.Clone()
+		clone.TLSClientConfig = &tls.Config{
+			RootCAs:    pool,
+			MinVersion: tls.VersionTLS12,
+		}
+		http.DefaultTransport = clone
+	}
+}
+
+// prefixedCertFiles is the list of CA-bundle files to try, relative to PathPrefix.
+var prefixedCertFiles = []string{
+	"/etc/ssl/certs/ca-certificates.crt",
+	"/etc/ssl/cert.pem",
+	"/etc/pki/tls/certs/ca-bundle.crt",
+	"/etc/ssl/ca-bundle.pem",
+	"/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
+}
+
+// prefixedCertDirs is the list of directories whose PEM/CRT files are loaded.
+var prefixedCertDirs = []string{
+	"/etc/ssl/certs",
+	"/system/etc/security/cacerts",
+}
+
+// BuildCertPool constructs an x509.CertPool from the prefixed CA stores
+// (Prefix("/etc/ssl/certs"), etc.).  Returns nil if PathPrefix is empty,
+// if no certificates can be found under the prefix, or if no certificates
+// could be parsed from the files that were found.
+// Callers that build a custom TLS config (e.g. registry resolvers) should
+// call this instead of relying on ConfigureTLS, which only patches
+// http.DefaultTransport.
+func BuildCertPool() *x509.CertPool {
+	if PathPrefix == "" {
+		return nil
+	}
+	pool := x509.NewCertPool()
+	loaded := false
+
+	for _, f := range prefixedCertFiles {
+		data, err := os.ReadFile(Prefix(f))
+		if err == nil && pool.AppendCertsFromPEM(data) {
+			loaded = true
+		}
+	}
+
+	for _, d := range prefixedCertDirs {
+		dir := Prefix(d)
+		entries, err := os.ReadDir(dir)
+		if err != nil {
+			continue
+		}
+		for _, entry := range entries {
+			if entry.IsDir() {
+				continue
+			}
+			ext := filepath.Ext(entry.Name())
+			if ext != ".pem" && ext != ".crt" {
+				continue
+			}
+			data, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+			if err == nil && pool.AppendCertsFromPEM(data) {
+				loaded = true
+			}
+		}
+	}
+
+	if !loaded {
+		return nil
+	}
+	return pool
+}
