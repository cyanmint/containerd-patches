@@ -122,6 +122,10 @@ containerd CLI
 			Value:   namespaces.Default,
 			EnvVars: []string{namespaces.NamespaceEnvVar},
 		},
+		&cli.StringFlag{
+			Name:  "prefix",
+			Usage: "Prefix directory for all containerd default paths",
+		},
 	}
 	app.Commands = append([]*cli.Command{
